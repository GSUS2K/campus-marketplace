NODE_ENV=production
PORT=3001
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/campus_marketplace
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=https://lpu-campus-marketplace.netlify.app
EMAIL_USER=verified-sender@example.com
EMAIL_PASS=provider-app-password

# Optional second factor for users who add a phone number.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+10000000000

# Optional; leave unset to keep event history in MongoDB without Kafka.
KAFKA_BROKER=
